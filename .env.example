APP_NAME="Financial Intelligence"
# local = desenvolvimento com dados reais | production = servidor (nunca APP_DEBUG=true)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Auto-corrige open_basedir (Hestia) e Telegram inbound em deploy, webhooks e scheduler
PLATFORM_AUTO_ENSURE_WEB_PHP=true
PLATFORM_AUTO_ENSURE_TELEGRAM=true

# Exigir senha ao alterar valor, descrição, data ou tipo de transação
FINANCIAL_REQUIRE_PASSWORD_ON_EDIT=true

# Cobrança de acesso — Liquidx API integrated (/api/integrated-payment)
LIQUIDX_API_BASE_URL=https://liquidx.pro/api
LIQUIDX_API_KEY=
LIQUIDX_INTEGRATED_CODE=51811385769176156555798127162395
LIQUIDX_INTEGRATED_PAYMENT_PATH=/integrated-payment
LIQUIDX_INTEGRATED_PAYMENT_STATUS_PATH=/integrated-payment/status
LIQUIDX_THIRDWALLET=
LIQUIDX_WEBHOOK_SECRET=
LIQUIDX_HTTP_TIMEOUT=20
LIQUIDX_DEFAULT_PAYER_PHONE=

# cURL SSL (erro 60 no Telegram/OpenAI em dev Linux: use o bundle do sistema)
# HTTP_VERIFY_SSL=false
# CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Força IPv4 para APIs externas quando o servidor resolve IPv6 sem rota (Telegram em alguns VPS)
HTTP_FORCE_IPV4=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Dev: financial | Testes PHPUnit: financial_test | Produção: outro nome (ex. financial_prod)
DB_DATABASE=financial
DB_USERNAME=financial
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local sem phpredis: database. Produção com Redis: redis
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@financial.local"
MAIL_FROM_NAME="${APP_NAME}"

# AI Providers
AI_PROVIDER=openai
AI_SYSTEM_ENABLED=true
AI_PLATFORM_BILLING_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OCR
OCR_PROVIDER=tesseract
TESSERACT_BINARY=tesseract
TESSERACT_LANG=por

# Integrations (credenciais padrão — usuários escolhem "sistema" em /integrations/notifications)
INTEGRATIONS_SYSTEM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INBOUND_ENABLED=true
# Webhook: true = processa na hora (padrão). false = fila (exige queue:work --queue=notifications)
TELEGRAM_INBOUND_SYNC=true
# Dev: com schedule:work, dispensa terminais separados de poll e fila
TELEGRAM_SCHEDULED_POLL=true
TELEGRAM_SCHEDULED_QUEUE=true
# IDs numéricos (vírgula) autorizados a /fila e /run daily|alerts|webhook
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_QUEUE_NAMES=notifications,default
# Retentativas ao baixar foto/PDF do Telegram (erro 35 / connection reset)
TELEGRAM_DOWNLOAD_RETRIES=3
TELEGRAM_DOWNLOAD_RETRY_DELAY_MS=800

# WhatsApp — evolution (opção A, padrão) ou http (gateway genérico legado)
WHATSAPP_PROVIDER=evolution
WHATSAPP_INBOUND_ENABLED=true
WHATSAPP_INBOUND_SYNC=true
EVOLUTION_API_URL=http://127.0.0.1:8085
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=financial-system
EVOLUTION_WEBHOOK_SECRET=
# URL que o Evolution (Docker) usa para chamar o Laravel — obrigatório se APP_URL é localhost
EVOLUTION_WEBHOOK_PUBLIC_URL=http://host.docker.internal:8000/api/v1/webhooks/whatsapp
EVOLUTION_STATUS_WORKSPACE_ID=1
EVOLUTION_HTTP_TIMEOUT=30
EVOLUTION_SERVER_URL=http://127.0.0.1:8085

# Legado: só se WHATSAPP_PROVIDER=http
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Gmail — OAuth do aplicativo Google. Cada usuário conecta a própria conta na UI; tokens ficam criptografados no banco.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
GMAIL_SCHEDULED_SYNC=false
GMAIL_SYNC_LIMIT=25
GMAIL_SEARCH_QUERY="newer_than:30d (compra OR gasto OR despesa OR pagamento OR pix OR recebido OR recebimento OR boleto OR fatura OR \"nota fiscal\" OR nf-e)"

# Horizon
HORIZON_PATH=horizon

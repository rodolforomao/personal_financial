APP_NAME="Financial Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=financial
DB_USERNAME=financial
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local sem phpredis: database. Produção com Redis: redis
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@financial.local"
MAIL_FROM_NAME="${APP_NAME}"

# AI Providers
AI_PROVIDER=openai
AI_SYSTEM_ENABLED=true
AI_PLATFORM_BILLING_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OCR
OCR_PROVIDER=tesseract
TESSERACT_BINARY=tesseract
TESSERACT_LANG=por

# Integrations (credenciais padrão — usuários escolhem "sistema" em /integrations/notifications)
INTEGRATIONS_SYSTEM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INBOUND_ENABLED=true

# WhatsApp — evolution (opção A, padrão) ou http (gateway genérico legado)
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=financial-system
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_STATUS_WORKSPACE_ID=1
EVOLUTION_HTTP_TIMEOUT=30
EVOLUTION_SERVER_URL=http://localhost:8081

# Legado: só se WHATSAPP_PROVIDER=http
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Horizon
HORIZON_PATH=horizon
